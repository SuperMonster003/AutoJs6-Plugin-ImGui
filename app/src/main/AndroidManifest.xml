<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_icon_studio_application">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />
        <meta-data
            android:name="org.autojs.plugin.sdk.registry"
            android:value="io.github.supermonster003.autojs6.plugin.imgui.ImGuiPluginRegistry" />
        <meta-data
            android:name="org.autojs.plugin.imgui.DEAR_IMGUI_VERSION"
            android:value="${imguiVersion}" />
        <meta-data
            android:name="org.autojs.plugin.imgui.NATIVE_ABIS"
            android:value="${imguiNativeAbis}" />
        <meta-data
            android:name="org.autojs.plugin.imgui.NATIVE_LIBRARY"
            android:value="${imguiNativeLibrary}" />
        <meta-data
            android:name="org.autojs.plugin.imgui.EXAMPLE_MANIFEST"
            android:value="examples/index.json" />
        <meta-data
            android:name="org.autojs.plugin.imgui.TYPESCRIPT_DECLARATION"
            android:value="types/imgui.d.ts" />
        <meta-data
            android:name="requiresHostVersion"
            android:value="${imguiRequiredHostVersion}" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".ImGuiPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="imgui-runtime" />
            </intent-filter>
        </service>

        <service
            android:name=".ImGuiPrivilegeBrokerService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":privilege_broker" />

        <provider
            android:name=".ImGuiPrivilegeBrokerProvider"
            android:authorities="${applicationId}.privilege_broker"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="false"
            android:process=":privilege_broker" />

    </application>

</manifest>
