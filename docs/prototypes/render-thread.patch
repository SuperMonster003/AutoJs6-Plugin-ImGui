+// Draws on the render thread (window context current) and presents; records the render and input statistics.
+void PresentDrawData(ImDrawData* drawData, int64_t renderStartNs, const std::vector<int64_t>& inputNs) {
+    EGLint width = 0;
+    EGLint height = 0;
+    eglQuerySurface(gState.display, gState.surface, EGL_WIDTH, &width);
+    eglQuerySurface(gState.display, gState.surface, EGL_HEIGHT, &height);
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+    glViewport(0, 0, width, height);
+    glClearColor(0.0F, 0.0F, 0.0F, 0.0F);
+    glClear(GL_COLOR_BUFFER_BIT);
+    ImGui_ImplOpenGL3_RenderDrawData(drawData);
+    if (eglSwapBuffers(gState.display, gState.surface) != EGL_TRUE) {
+        LOG_ERROR("Render thread eglSwapBuffers failed: 0x%x", eglGetError());
+        return;
+    }
+    RecordPresent(renderStartNs, MonotonicNanos(), inputNs);
+}
+
+void RenderSnapshotLoop() {
+    while (true) {
+        int slotIndex = -1;
+        {
+            std::unique_lock<std::mutex> lock(gRender.mutex);
+            gRender.wake.wait(lock, [] { return gRender.stop || gRender.pendingSlot >= 0; });
+            if (gRender.stop) {
+                return;
+            }
+            slotIndex = gRender.pendingSlot;
+            gRender.pendingSlot = -1;
+            gRender.renderingSlot = slotIndex;
+        }
+        DrawSnapshot& slot = gRender.slots[static_cast<size_t>(slotIndex)];
+        const int64_t renderStartNs = MonotonicNanos();
+        if (slot.fence != nullptr) {
+            glWaitSync(slot.fence, 0, GL_TIMEOUT_IGNORED);
+            glDeleteSync(slot.fence);
+            slot.fence = nullptr;
+        }
+        PresentDrawData(&slot.data, renderStartNs, slot.inputNs);
+        if (!slot.deleteTextures.empty()) {
+            glDeleteTextures(static_cast<GLsizei>(slot.deleteTextures.size()), slot.deleteTextures.data());
+            slot.deleteTextures.clear();
+        }
+        slot.inputNs.clear();
+        std::lock_guard<std::mutex> lock(gRender.mutex);
+        gRender.renderingSlot = -1;
+    }
+}
+
+// Called with gRender.mutex held: the value the render thread shows is the recorded one unless the user edited it and
+// the script has not read the edit yet.
+ReplayWidget& ResolveReplayWidget(const ReplayOp& op, uint64_t serial) {
+    ReplayWidget& widget = gRender.widgets[op.key];
+    if (!widget.known || (!widget.dirty && serial > widget.staleThrough)) {
+        widget.known = true;
+        widget.checked = op.checked;
+        widget.value = op.values[0];
+    }
+    return widget;
+}
+
+void MarkReplayWidgetEdited(ReplayWidget& widget) {
+    widget.dirty = true;
+    widget.staleThrough = std::max(widget.staleThrough, gRender.publishedSerial);
+}
+
+void ExecuteReplayProgram(const ReplayProgram& program) {
+    int depth = 0;
+    for (const ReplayOp& op : program.ops) {
+        switch (op.kind) {
+            case kOpSetNextWindowPos:
+                ImGui::SetNextWindowPos(
+                    ImVec2(op.values[0], op.values[1]),
+                    static_cast<ImGuiCond>(op.flags),
+                    ImVec2(op.values[2], op.values[3])
+                );
+                break;
+            case kOpSetNextWindowSize:
+                ImGui::SetNextWindowSize(ImVec2(op.values[0], op.values[1]), static_cast<ImGuiCond>(op.flags));
+                break;
+            case kOpBegin: {
+                const bool visible = ImGui::Begin(op.label.c_str(), nullptr, static_cast<ImGuiWindowFlags>(op.flags));
+                ++depth;
+                std::lock_guard<std::mutex> lock(gRender.mutex);
+                gRender.widgets[op.key].visible = visible;
+                break;
+            }
+            case kOpEnd:
+                if (depth > 0) {
+                    ImGui::End();
+                    --depth;
+                }
+                break;
+            case kOpText:
+                ImGui::TextUnformatted(op.label.c_str());
+                break;
+            case kOpButton:
+                if (ImGui::Button(op.label.c_str(), ImVec2(op.values[0], op.values[1]))) {
+                    std::lock_guard<std::mutex> lock(gRender.mutex);
+                    gRender.widgets[op.key].pendingClicks += 1;
+                }
+                break;
+            case kOpCheckbox: {
+                bool checked = false;
+                {
+                    std::lock_guard<std::mutex> lock(gRender.mutex);
+                    checked = ResolveReplayWidget(op, program.serial).checked;
+                }
+                if (ImGui::Checkbox(op.label.c_str(), &checked)) {
+                    std::lock_guard<std::mutex> lock(gRender.mutex);
+                    ReplayWidget& widget = gRender.widgets[op.key];
+                    widget.checked = checked;
+                    MarkReplayWidgetEdited(widget);
+                }
+                break;
+            }
+            case kOpSliderFloat: {
+                float value = 0.0F;
+                {
+                    std::lock_guard<std::mutex> lock(gRender.mutex);
+                    value = ResolveReplayWidget(op, program.serial).value;
+                }
+                if (ImGui::SliderFloat(
+                        op.label.c_str(),
+                        &value,
+                        op.values[1],
+                        op.values[2],
+                        op.format.empty() ? "%.3f" : op.format.c_str(),
+                        static_cast<ImGuiSliderFlags>(op.flags)
+                    )
+                ) {
+                    std::lock_guard<std::mutex> lock(gRender.mutex);
+                    ReplayWidget& widget = gRender.widgets[op.key];
+                    widget.value = value;
+                    MarkReplayWidgetEdited(widget);
+                }
+                break;
+            }
+            case kOpSameLine:
+                ImGui::SameLine(op.values[0], op.values[1]);
+                break;
+            case kOpSeparator:
+                ImGui::Separator();
+                break;
+        }
+    }
+    while (depth-- > 0) {
+        ImGui::End();
+    }
+}
+
+void RenderReplayLoop() {
+    const auto interval = std::chrono::nanoseconds(1000000000LL / std::max(1, gRender.fps));
+    auto deadline = std::chrono::steady_clock::now();
+    std::vector<ReplayInput> inputs;
+    std::vector<int64_t> inputNs;
+    while (true) {
+        std::shared_ptr<const ReplayProgram> program;
+        {
+            std::unique_lock<std::mutex> lock(gRender.mutex);
+            if (gRender.wake.wait_until(lock, deadline, [] { return gRender.stop; })) {
+                return;
+            }
+            inputs.swap(gRender.inputs);
+            program = gRender.program;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        deadline += interval;
+        if (deadline < now) {
+            deadline = now + interval;
+        }
+        const int64_t renderStartNs = MonotonicNanos();
+        inputNs.clear();
+        for (const ReplayInput& input : inputs) {
+            ApplyTouch(input.action, input.x, input.y, input.button);
+            if (input.timeNs > 0) {
+                inputNs.push_back(input.timeNs);
+            }
+        }
+        inputs.clear();
+        ImGui_ImplOpenGL3_NewFrame();
+        ImGui_ImplAndroid_NewFrame();
+        ImGui::NewFrame();
+        ApplyCancelledMouseButtons();
+        if (program != nullptr) {
+            ExecuteReplayProgram(*program);
+        }
+        ImGui::Render();
+        UpdateWindowMetadata();
+        {
+            std::lock_guard<std::mutex> lock(gMetadataMutex);
+            const ImGuiIO& io = ImGui::GetIO();
+            gRender.anyItemHovered = ImGui::IsAnyItemHovered();
+            gRender.anyItemActive = ImGui::IsAnyItemActive();
+            gRender.wantCaptureMouse = io.WantCaptureMouse;
+            gRender.wantTextInput = io.WantTextInput;
+            gRender.mousePos = io.MousePos;
+        }
+        PresentDrawData(ImGui::GetDrawData(), renderStartNs, inputNs);
+    }
+}
