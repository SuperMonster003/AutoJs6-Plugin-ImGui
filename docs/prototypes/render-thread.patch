     }
 }
 
+// R8 prototype: an independent render thread, selected by createWindow({renderThread}) before init and started by the
+// first frame (after the UI thread has applied the initial style).
+// - snapshot: the script thread builds the frame as before, but on a pbuffer context that shares objects with the
+//   window context; after ImGui::Render it uploads textures, copies ImDrawData into a latest-wins mailbox and returns.
+//   The render thread owns the window surface and draws the newest copy.
+// - replay: the script thread only records a subset of widget calls; the render thread runs Dear ImGui itself at fps
+//   with live input, executes the newest recording and hands widget results (clicks, edited values) to the next
+//   script frame.
+constexpr int kRenderThreadOff = 0;
+constexpr int kRenderThreadSnapshot = 1;
+constexpr int kRenderThreadReplay = 2;
+
+struct DrawSnapshot {
+    ImDrawData data;
+    ImVector<ImDrawList*> lists;
+    std::vector<GLuint> deleteTextures;
+    std::vector<int64_t> inputNs;
+    GLsync fence = nullptr;
+};
+
+enum ReplayOpKind {
+    kOpSetNextWindowPos,
+    kOpSetNextWindowSize,
+    kOpBegin,
+    kOpEnd,
+    kOpText,
+    kOpButton,
+    kOpCheckbox,
+    kOpSliderFloat,
+    kOpSameLine,
+    kOpSeparator,
+};
+
+struct ReplayOp {
+    ReplayOpKind kind = kOpText;
+    std::string label;
+    std::string key;
+    std::string format;
+    std::array<float, 4> values{};
+    int flags = 0;
+    bool checked = false;
+};
+
+struct ReplayProgram {
+    uint64_t serial = 0U;
+    std::vector<ReplayOp> ops;
+};
+
+// Widget results shared by both threads (under RenderThreadState::mutex). A value edited on the render thread is
+// "dirty" until a script frame reads it; recordings up to staleThrough still carry the old value and are not applied.
+struct ReplayWidget {
+    bool known = false;
+    bool dirty = false;
+    uint64_t staleThrough = 0U;
+    int pendingClicks = 0;
+    bool visible = true;
+    bool checked = false;
+    float value = 0.0F;
+};
+
+struct ReplayInput {
+    int action = 0;
+    float x = 0.0F;
+    float y = 0.0F;
+    int button = 0;
+    int64_t timeNs = 0;
+};
+
+struct RenderThreadState {
+    int mode = kRenderThreadOff;
+    int fps = 60;
+    std::thread thread;
+    std::mutex mutex;
+    std::condition_variable wake;
+    bool stop = false;
+    // snapshot
+    EGLContext buildContext = EGL_NO_CONTEXT;
+    EGLSurface buildSurface = EGL_NO_SURFACE;
+    std::array<DrawSnapshot, 3> slots;
+    int pendingSlot = -1;
+    int renderingSlot = -1;
+    // replay: recording state is owned by the script thread, the rest is under mutex
+    bool recording = false;
+    uint64_t recordSerial = 0U;
+    std::vector<ReplayOp> recordOps;
+    std::vector<std::string> recordWindows;
+    std::shared_ptr<const ReplayProgram> program;
+    uint64_t publishedSerial = 0U;
+    std::unordered_map<std::string, ReplayWidget> widgets;
+    std::vector<ReplayInput> inputs;
+    // queries answered from the last replayed frame (under gMetadataMutex)
+    bool anyItemHovered = false;
+    bool anyItemActive = false;
+    bool wantCaptureMouse = false;
+    bool wantTextInput = false;
+    ImVec2 mousePos{};
+};
+
+RenderThreadState gRender;
+// Set by nativeSetRenderThreadMode (under NATIVE_LOCK) and applied by the next nativeInit.
+int gRequestedRenderThreadMode = kRenderThreadOff;
+int gRequestedRenderThreadFps = 60;
+// Guards the window metadata, which the replay render thread writes while the script and UI threads read it.
+std::mutex gMetadataMutex;
