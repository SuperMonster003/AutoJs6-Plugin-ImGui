+void RenderThreadMain() {
+    pthread_setname_np(pthread_self(), "ImGuiRender");
+    if (eglMakeCurrent(gState.display, gState.surface, gState.surface, gState.context) != EGL_TRUE) {
+        LOG_ERROR("Render thread eglMakeCurrent failed: 0x%x", eglGetError());
+        return;
+    }
+    if (gRender.mode == kRenderThreadSnapshot) {
+        RenderSnapshotLoop();
+    } else {
+        RenderReplayLoop();
+    }
+    eglMakeCurrent(gState.display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+}
+
+void StartRenderThread() {
+    if (gRender.mode == kRenderThreadOff || gRender.thread.joinable() || !gState.ready ||
+        gState.surface == EGL_NO_SURFACE
+    ) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(gRender.mutex);
+        gRender.stop = false;
+    }
+    gRender.thread = std::thread(RenderThreadMain);
+}
+
+void StopRenderThread() {
+    if (!gRender.thread.joinable()) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(gRender.mutex);
+        gRender.stop = true;
+    }
+    gRender.wake.notify_all();
+    gRender.thread.join();
+    std::lock_guard<std::mutex> lock(gRender.mutex);
+    gRender.stop = false;
+}
+
+// After the render thread stopped, with a context of the share group current: frees the snapshot pool and the replay
+// state. The build context itself is destroyed with the window context.
+void ReleaseRenderThreadResources() {
+    const bool current = IsRendererContextCurrent();
+    for (DrawSnapshot& slot : gRender.slots) {
+        if (slot.fence != nullptr && current) {
+            glDeleteSync(slot.fence);
+        }
+        slot.fence = nullptr;
+        if (!slot.deleteTextures.empty() && current) {
+            glDeleteTextures(static_cast<GLsizei>(slot.deleteTextures.size()), slot.deleteTextures.data());
+        }
+        slot.deleteTextures.clear();
+        slot.inputNs.clear();
+        for (ImDrawList* list : slot.lists) {
+            IM_DELETE(list);
+        }
+        slot.lists.clear();
+        slot.data.CmdLists.clear();
+        slot.data.CmdListsCount = 0;
+    }
+    std::lock_guard<std::mutex> lock(gRender.mutex);
+    gRender.pendingSlot = -1;
+    gRender.renderingSlot = -1;
+    gRender.recording = false;
+    gRender.recordSerial = 0U;
+    gRender.recordOps.clear();
+    gRender.recordWindows.clear();
+    gRender.program.reset();
+    gRender.publishedSerial = 0U;
+    gRender.widgets.clear();
+    gRender.inputs.clear();
+}
+
+bool CreateBuildContext() {
+    constexpr EGLint pbufferAttributes[] = {
+        EGL_WIDTH, 1,
+        EGL_HEIGHT, 1,
+        EGL_NONE,
+    };
+    constexpr EGLint contextAttributes[] = {
+        EGL_CONTEXT_CLIENT_VERSION, 3,
+        EGL_NONE,
+    };
+    gRender.buildSurface = eglCreatePbufferSurface(gState.display, gState.config, pbufferAttributes);
+    if (gRender.buildSurface == EGL_NO_SURFACE) {
+        LOG_ERROR("Build pbuffer creation failed: 0x%x", eglGetError());
+        return false;
+    }
+    gRender.buildContext = eglCreateContext(gState.display, gState.config, gState.context, contextAttributes);
+    if (gRender.buildContext == EGL_NO_CONTEXT) {
+        LOG_ERROR("Build context creation failed: 0x%x", eglGetError());
+        return false;
+    }
+    return true;
+}
