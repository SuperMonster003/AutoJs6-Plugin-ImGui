+extern "C" JNIEXPORT void JNICALL
+Java_io_github_supermonster003_autojs6_plugin_imgui_ImGuiNative_nativeTouchEvent(
+    JNIEnv*, jclass, jint action, jfloat x, jfloat y, jint mouseButton
+);
+
+extern "C" JNIEXPORT void JNICALL
+Java_io_github_supermonster003_autojs6_plugin_imgui_ImGuiNative_nativeTouchEventTimed(
+    JNIEnv* env,
+    jclass type,
+    jint action,
+    jfloat x,
+    jfloat y,
+    jint mouseButton,
+    jlong eventTimeNanos
+) {
+    if (!gState.ready || ImGui::GetCurrentContext() == nullptr) {
