+        }
+    }
+}
+
+extern "C" JNIEXPORT jdoubleArray JNICALL
+Java_io_github_supermonster003_autojs6_plugin_imgui_ImGuiNative_nativeGetFrameStats(
+    JNIEnv* env,
+    jclass,
+    jboolean reset
+) {
+    std::lock_guard<std::mutex> lock(gStats.mutex);
+    const std::array<const std::vector<double>*, 5> series = {
+        &gStats.buildMs, &gStats.submitMs, &gStats.renderMs, &gStats.presentMs, &gStats.inputLatencyMs,
+    };
+    std::vector<double> flat;
+    for (const auto* values : series) {
+        flat.push_back(static_cast<double>(values->size()));
+    }
+    for (const auto* values : series) {
+        flat.insert(flat.end(), values->begin(), values->end());
+    }
+    if (reset) {
+        gStats.buildMs.clear();
+        gStats.submitMs.clear();
+        gStats.renderMs.clear();
+        gStats.presentMs.clear();
+        gStats.inputLatencyMs.clear();
+        gStats.originNs = MonotonicNanos();
+    }
+    jdoubleArray result = env->NewDoubleArray(static_cast<jsize>(flat.size()));
+    if (result != nullptr) {
+        env->SetDoubleArrayRegion(result, 0, static_cast<jsize>(flat.size()), flat.data());
+    }
+    return result;
+}
+
+extern "C" JNIEXPORT jlong JNICALL
+Java_io_github_supermonster003_autojs6_plugin_imgui_ImGuiNative_nativeGetLastReleaseEventNanos(
+    JNIEnv*,
+    jclass
+) {
+    return static_cast<jlong>(gLastReleaseEventNs.load());
+}
