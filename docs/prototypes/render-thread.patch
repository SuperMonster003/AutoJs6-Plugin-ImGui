From 22433001fda9ec2ec400e418fd596a3e77ff6878 Mon Sep 17 00:00:00 2001
From: SuperMonster003 <wu2du2mo2gu0@gmail.com>
Date: Thu, 29 Oct 2026 22:36:23 +0800
Subject: [PATCH 3/7] R8: device measurement script (frame time, touch latency,
 sleep freeze, threads, memory)

---
 tools/device_r8_render_thread.py | 555 +++++++++++++++++++++++++++++++
 1 file changed, 555 insertions(+)
 create mode 100644 tools/device_r8_render_thread.py

diff --git a/tools/device_r8_render_thread.py b/tools/device_r8_render_thread.py
new file mode 100644
index 0000000..e8605e4
--- /dev/null
+++ b/tools/device_r8_render_thread.py
@@ -0,0 +1,555 @@
+#!/usr/bin/env python3
+"""Measures the frame loop of the ImGui plugin for the R8 render thread evaluation (prototype vs current code).
+
+Usage:
+  py -3.12 -I tools/device_r8_render_thread.py -s SERIAL --label LABEL --modes off,snapshot,replay --out DIR
+  py -3.12 -I tools/device_r8_render_thread.py --table DIR
+
+Needs AutoJs6 with the global `imgui`, the plugin build under test (the R8 probe or prototype commit) installed,
+enabled and trusted, and the overlay permission for AutoJs6. For each mode it pushes one script, runs it through
+RunIntentActivity and drives the touches with `adb shell input`; the script waits for an acknowledgement file before
+it ends each touch phase. The same script and window run for every mode:
+
+- calibration: a window with renderThread "off" maps the screen to the surface (one swipe on a blank area) and records
+  the button and slider positions;
+- light / heavy: 5 s of a small window, then of the same window with 300 more text lines;
+- touch: 3 swipes on the slider and 5 taps on the button; latency touch-to-present (native) and touch-to-script
+  (the frame where button() returned true);
+- freeze: the render callback sleeps 500 ms once per second while the slider is swiped for about 4 s;
+- threads and memory (PSS, graphics, native heap) before the window, while it is open and after it closed.
+
+Prints PASS / FAIL for the functional checks and the measured values only; the raw JSON of each run and a summary go
+to --out. --table prints a Markdown comparison of every summary in a directory.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import pathlib
+import subprocess
+import sys
+import time
+
+DEVICE_DIR = "/sdcard/Download/aj6-imgui-r8"
+RUN_ACTIVITY = "org.autojs.autojs.external.open.RunIntentActivity"
+PACKAGE = "org.autojs.autojs6"
+MARK = "AJ6R8"
+LOG_TAIL = 5000
+
+# Window geometry in pixels; the button and the slider are measured by the calibration window.
+WINDOW_X = 60
+WINDOW_Y = 500
+WINDOW_W = 1200
+WINDOW_H = 1300
+BUTTON_H = 140
+
+SCRIPT = r"""
+var MARK = 'AJ6R8';
+var MODE = '__MODE__';
+var DIR = '__DIR__';
+var X = __X__, Y = __Y__, W = __W__, H = __H__, BUTTON_H = __BUTTON_H__;
+var FLAGS = imgui.WindowFlags.NoTitleBar | imgui.WindowFlags.NoResize | imgui.WindowFlags.NoMove |
+    imgui.WindowFlags.NoCollapse | imgui.WindowFlags.NoSavedSettings;
+var result = {mode: MODE, phases: {}, samples: {}, errors: []};
+var state = {heavy: false, sleepFrames: false, lastSleepNs: 0, sleeps: [], clicks: [], frames: 0, edits: 0,
+    value: {value: 20}, layout: null, mouse: null, replayRejects: null};
+
+function log(text) { console.log(MARK + ' ' + text); }
+function nowNs() { return Number(java.lang.System.nanoTime()); }
+
+function renderThreads() {
+    var names = new java.io.File('/proc/self/task').list();
+    var render = 0;
+    for (var i = 0; i < names.length; i++) {
+        try {
+            var reader = new java.io.BufferedReader(new java.io.FileReader('/proc/self/task/' + names[i] + '/comm'));
+            var name = String(reader.readLine());
+            reader.close();
+            if (name === 'ImGuiRender') render++;
+        } catch (ignored) {}
+    }
+    return {total: names.length, render: render};
+}
+
+function sample(name) {
+    java.lang.Runtime.getRuntime().gc();
+    var info = new android.os.Debug.MemoryInfo();
+    android.os.Debug.getMemoryInfo(info);
+    var threads = renderThreads();
+    result.samples[name] = {
+        threads: threads.total,
+        renderThreads: threads.render,
+        pssKb: Number(info.getTotalPss()),
+        graphicsKb: Number(info.getMemoryStat('summary.graphics')),
+        nativeKb: Number(info.getMemoryStat('summary.native-heap'))
+    };
+}
+
+function awaitAck(phase, done) {
+    var path = DIR + '/ack-' + phase;
+    log('await ' + phase);
+    var timer = setInterval(function () {
+        if (files.exists(path)) {
+            clearInterval(timer);
+            done();
+        }
+    }, 50);
+}
+
+function windowOptions(mode) {
+    return {x: X, y: Y, width: W, height: H, fps: 60, movable: false, renderThread: mode};
+}
+
+function draw(ui, record) {
+    ui.setNextWindowPos(0, 0);
+    ui.setNextWindowSize(W, H);
+    if (ui.begin('R8', null, FLAGS)) {
+        ui.text('R8 ' + MODE + ' frame ' + state.frames + ' clicks ' + state.clicks.length);
+        var button = record ? ui.getCursorPos() : null;
+        if (ui.button('Tap', W - 60, BUTTON_H)) {
+            state.clicks.push((nowNs() - imgui._lastReleaseEventNanos()) / 1e6);
+        }
+        var slider = record ? ui.getCursorPos() : null;
+        if (ui.sliderFloat('Value', state.value, 0, 100, '%.1f')) state.edits++;
+        var after = record ? ui.getCursorPos() : null;
+        if (state.heavy) {
+            for (var i = 0; i < 300; i++) ui.text('line ' + i + ' frame ' + state.frames);
+        }
+        if (record) {
+            state.layout = {button: [button[0], button[1]], slider: [slider[0], slider[1]], sliderEnd: after[1]};
+            var mouse = ui.getMousePos();
+            if (mouse[0] > -10000 && mouse[1] > -10000) state.mouse = [mouse[0], mouse[1]];
+        }
+    }
+    ui.end();
+}
+
+function stats(name, startFrames) {
+    var data = imgui._renderStats(true);
+    data.scriptFrames = state.frames - startFrames;
+    result.phases[name] = data;
+}
+
+function calibrate(next) {
+    var session = imgui.createWindow(function (ui) { draw(ui, true); }, windowOptions('off'));
+    setTimeout(function () {
+        awaitAck('calib', function () {
+            setTimeout(function () {
+                var layout = state.layout;
+                var mouse = state.mouse;
+                log('calib mouse=' + (mouse ? mouse.join(',') : 'none') +
+                    ' button=' + (layout ? layout.button.join(',') : 'none') +
+                    ' slider=' + (layout ? layout.slider.join(',') + ',' + layout.sliderEnd : 'none'));
+                session.close();
+                waitClosed(session, function () { setTimeout(next, 1500); });
+            }, 300);
+        });
+    }, 1500);
+}
+
+function waitClosed(session, done) {
+    var timer = setInterval(function () {
+        if (session.closed) {
+            clearInterval(timer);
+            done();
+        }
+    }, 50);
+}
+
+function measure() {
+    sample('before');
+    state.frames = 0;
+    var session = imgui.createWindow(function (ui) {
+        state.frames++;
+        if (MODE === 'replay' && state.frames === 3) {
+            try {
+                ui.getCursorPos();
+                state.replayRejects = false;
+            } catch (e) {
+                state.replayRejects = true;
+            }
+        }
+        draw(ui, false);
+        if (state.sleepFrames) {
+            var start = nowNs();
+            if (start - state.lastSleepNs >= 1e9) {
+                state.lastSleepNs = start;
+                sleep(500);
+                state.sleeps.push([start, nowNs()]);
+            }
+        }
+    }, windowOptions(MODE));
+
+    var steps = [];
+    function run() {
+        var step = steps.shift();
+        if (step) step();
+    }
+    steps.push(function () { setTimeout(function () { sample('open'); imgui._renderStats(true); run(); }, 1500); });
+    steps.push(function () {
+        var frames = state.frames;
+        setTimeout(function () { stats('light', frames); run(); }, 5000);
+    });
+    steps.push(function () {
+        state.heavy = true;
+        imgui._renderStats(true);
+        var frames = state.frames;
+        setTimeout(function () { stats('heavy', frames); state.heavy = false; run(); }, 5000);
+    });
+    steps.push(function () {
+        setTimeout(function () {
+            imgui._renderStats(true);
+            state.clicks = [];
+            state.edits = 0;
+            state.value.value = 20;
+            var frames = state.frames;
+            awaitAck('touch', function () {
+                setTimeout(function () {
+                    stats('touch', frames);
+                    result.phases.touch.clickLatencyMs = state.clicks.slice();
+                    result.phases.touch.sliderValue = state.value.value;
+                    result.phases.touch.edits = state.edits;
+                    run();
+                }, 800);
+            });
+        }, 500);
+    });
+    steps.push(function () {
+        imgui._renderStats(true);
+        var resetNs = nowNs();
+        var frames = state.frames;
+        state.sleeps = [];
+        state.lastSleepNs = 0;
+        state.sleepFrames = true;
+        awaitAck('freeze', function () {
+            state.sleepFrames = false;
+            setTimeout(function () {
+                stats('freeze', frames);
+                result.phases.freeze.sleepsMs = state.sleeps.map(function (s) {
+                    return [(s[0] - resetNs) / 1e6, (s[1] - resetNs) / 1e6];
+                });
+                run();
+            }, 800);
+        });
+    });
+    steps.push(function () {
+        session.close();
+        waitClosed(session, function () {
+            setTimeout(function () {
+                sample('closed');
+                result.replayRejects = state.replayRejects;
+                result.closeReason = String(session.closeReason);
+                files.write(DIR + '/result-' + MODE + '.json', JSON.stringify(result));
+                log('done');
+                exit();
+            }, 1500);
+        });
+    });
+    run();
+}
+
+try {
+    calibrate(measure);
+} catch (e) {
+    log('error ' + String(e).slice(0, 300));
+    exit();
+}
+"""
+
+
+def adb(serial: str, *args: str, check: bool = False) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(["adb", "-s", serial, *args], capture_output=True, text=True, encoding="utf-8",
+                          errors="replace", check=check)
+
+
+def marked_lines(serial: str) -> list[str]:
+    out = adb(serial, "logcat", "-d", "-t", str(LOG_TAIL)).stdout
+    lines = []
+    for line in out.splitlines():
+        if "GlobalConsole: " not in line:
+            continue
+        text = line.split("GlobalConsole: ", 1)[1].rstrip()
+        at = text.find(MARK + " ")
+        if at >= 0:
+            lines.append(text[at + len(MARK) + 1:])
+    return lines
+
+
+def pct(values: list[float], p: float) -> float | None:
+    if not values:
+        return None
+    ordered = sorted(values)
+    k = (len(ordered) - 1) * p / 100.0
+    low = int(k)
+    high = min(low + 1, len(ordered) - 1)
+    return ordered[low] + (ordered[high] - ordered[low]) * (k - low)
+
+
+def intervals(present: list[float]) -> list[float]:
+    return [b - a for a, b in zip(present, present[1:])]
+
+
+class Driver:
+    """Turns the calibration line into screen coordinates and performs the touches of each phase."""
+
+    def __init__(self, serial: str):
+        self.serial = serial
+        self.button = (0, 0)
+        self.slider = (0, 0, 0)
+
+    def calib_target(self) -> tuple[int, int]:
+        return WINDOW_X + WINDOW_W // 2, WINDOW_Y + WINDOW_H - 150
+
+    def swipe(self, x1: int, y1: int, x2: int, y2: int, ms: int) -> None:
+        adb(self.serial, "shell", "input", "swipe", str(x1), str(y1), str(x2), str(y2), str(ms))
+
+    def tap(self, x: int, y: int) -> None:
+        adb(self.serial, "shell", "input", "tap", str(x), str(y))
+
+    def calibrate_touch(self) -> None:
+        x, y = self.calib_target()
+        self.swipe(x, y, x + 2, y, 400)
+
+    def apply_calibration(self, line: str) -> bool:
+        fields = dict(part.split("=", 1) for part in line.split()[1:])
+        if "none" in fields.values():
+            return False
+        mx, my = (float(v) for v in fields["mouse"].split(","))
+        bx, by = (float(v) for v in fields["button"].split(","))
+        sx, sy, ey = (float(v) for v in fields["slider"].split(","))
+        tx, ty = self.calib_target()
+        ox, oy = tx - mx, ty - my
+        self.button = (int(ox + bx + (WINDOW_W - 60) / 2), int(oy + by + BUTTON_H / 2))
+        width = int(WINDOW_W * 0.65)
+        self.slider = (int(ox + sx + width * 0.1), int(ox + sx + width * 0.9), int(oy + (sy + ey) / 2 - 4))
+        return True
+
+    def touch_phase(self) -> None:
+        left, right, y = self.slider
+        for index in range(3):
+            if index % 2 == 0:
+                self.swipe(left, y, right, y, 600)
+            else:
+                self.swipe(right, y, left, y, 600)
+            time.sleep(0.3)
+        for _ in range(5):
+            self.tap(*self.button)
+            time.sleep(0.7)
+
+    def freeze_phase(self) -> None:
+        left, right, y = self.slider
+        for index in range(4):
+            if index % 2 == 0:
+                self.swipe(left, y, right, y, 900)
+            else:
+                self.swipe(right, y, left, y, 900)
+
+
+def run_mode(serial: str, mode: str, out: pathlib.Path, label: str, timeout: float) -> dict | None:
+    script = (SCRIPT.replace("__MODE__", mode).replace("__DIR__", DEVICE_DIR)
+              .replace("__X__", str(WINDOW_X)).replace("__Y__", str(WINDOW_Y))
+              .replace("__W__", str(WINDOW_W)).replace("__H__", str(WINDOW_H))
+              .replace("__BUTTON_H__", str(BUTTON_H)))
+    local = out / f"script-{mode}.js"
+    local.write_text(script, encoding="utf-8")
+    remote = DEVICE_DIR + f"/r8-{mode}.js"
+    adb(serial, "shell", "rm", "-rf", DEVICE_DIR)
+    adb(serial, "shell", "mkdir", "-p", DEVICE_DIR, check=True)
+    adb(serial, "push", str(local), remote, check=True)
+    local.unlink()
+    adb(serial, "logcat", "-c")
+    adb(serial, "shell", "am", "start", "-n", PACKAGE + "/" + RUN_ACTIVITY, "-e", "path", remote, check=True)
+    driver = Driver(serial)
+    seen: set[str] = set()
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        time.sleep(0.3)
+        for line in marked_lines(serial):
+            if line in seen:
+                continue
+            seen.add(line)
+            if line.startswith("error "):
+                print(f"{label}-{mode} script FAIL {line[6:]}")
+                return None
+            if line == "await calib":
+                driver.calibrate_touch()
+                adb(serial, "shell", "touch", DEVICE_DIR + "/ack-calib")
+            elif line.startswith("calib "):
+                ok = driver.apply_calibration(line)
+                print(f"{label}-{mode} calibration {'PASS' if ok else 'FAIL'} button={driver.button} "
+                      f"slider={driver.slider}")
+                if not ok:
+                    return None
+            elif line == "await touch":
+                driver.touch_phase()
+                adb(serial, "shell", "touch", DEVICE_DIR + "/ack-touch")
+            elif line == "await freeze":
+                driver.freeze_phase()
+                adb(serial, "shell", "touch", DEVICE_DIR + "/ack-freeze")
+            elif line == "done":
+                raw = out / f"raw-{label}-{mode}.json"
+                adb(serial, "pull", DEVICE_DIR + f"/result-{mode}.json", str(raw), check=True)
+                adb(serial, "shell", "rm", "-rf", DEVICE_DIR)
+                return json.loads(raw.read_text(encoding="utf-8"))
+    print(f"{label}-{mode} script FAIL timeout after {timeout:.0f} s")
+    adb(serial, "shell", "rm", "-rf", DEVICE_DIR)
+    return None
+
+
+def summarize(raw: dict) -> dict:
+    phases = raw["phases"]
+    samples = raw["samples"]
+    summary: dict = {"mode": raw["mode"]}
+    for name in ("light", "heavy"):
+        data = phases[name]
+        frames = intervals(data["presentMs"])
+        span = (data["presentMs"][-1] - data["presentMs"][0]) / 1000 if len(data["presentMs"]) > 1 else 0
+        summary[name] = {
+            "presentFps": (len(data["presentMs"]) - 1) / span if span > 0 else 0,
+            "frameP50": pct(frames, 50), "frameP95": pct(frames, 95),
+            "buildP50": pct(data["buildMs"], 50), "buildP95": pct(data["buildMs"], 95),
+            "submitP50": pct(data["submitMs"], 50), "submitP95": pct(data["submitMs"], 95),
+            "renderP50": pct(data["renderMs"], 50), "renderP95": pct(data["renderMs"], 95),
+            "scriptFps": data["scriptFrames"] / 5.0,
+        }
+    touch = phases["touch"]
+    summary["touch"] = {
+        "presentP50": pct(touch["inputLatencyMs"], 50), "presentP95": pct(touch["inputLatencyMs"], 95),
+        "clickP50": pct(touch["clickLatencyMs"], 50), "clickP95": pct(touch["clickLatencyMs"], 95),
+        "clicks": len(touch["clickLatencyMs"]), "sliderValue": touch["sliderValue"], "edits": touch["edits"],
+    }
+    freeze = phases["freeze"]
+    present = freeze["presentMs"]
+    inside = sum(1 for p in present for start, end in freeze["sleepsMs"] if start + 20 < p < end - 20)
+    summary["freeze"] = {
+        "sleeps": len(freeze["sleepsMs"]),
+        "presentsInSleeps": inside,
+        "maxGapMs": max(intervals(present)) if len(present) > 1 else None,
+        "inputP50": pct(freeze["inputLatencyMs"], 50), "inputP95": pct(freeze["inputLatencyMs"], 95),
+        "inputMax": max(freeze["inputLatencyMs"]) if freeze["inputLatencyMs"] else None,
+    }
+    before, opened, closed = samples["before"], samples["open"], samples["closed"]
+    summary["resources"] = {
+        "threadsBefore": before["threads"], "threadsOpen": opened["threads"], "threadsClosed": closed["threads"],
+        "renderThreadsOpen": opened["renderThreads"], "renderThreadsClosed": closed["renderThreads"],
+        "pssDeltaKb": opened["pssKb"] - before["pssKb"],
+        "graphicsDeltaKb": opened["graphicsKb"] - before["graphicsKb"],
+        "nativeDeltaKb": opened["nativeKb"] - before["nativeKb"],
+        "pssAfterCloseKb": closed["pssKb"] - before["pssKb"],
+    }
+    summary["replayRejects"] = raw.get("replayRejects")
+    return summary
+
+
+def fmt(value) -> str:
+    if value is None:
+        return "-"
+    if isinstance(value, float):
+        return f"{value:.1f}"
+    return str(value)
+
+
+def report(label: str, summary: dict) -> bool:
+    mode = summary["mode"]
+    name = f"{label}-{mode}"
+    for phase in ("light", "heavy"):
+        s = summary[phase]
+        print(f"{name} {phase} present-fps={fmt(s['presentFps'])} frame-p50={fmt(s['frameP50'])} "
+              f"frame-p95={fmt(s['frameP95'])} build-p50={fmt(s['buildP50'])} build-p95={fmt(s['buildP95'])} "
+              f"submit-p50={fmt(s['submitP50'])} render-p50={fmt(s['renderP50'])} script-fps={fmt(s['scriptFps'])}")
+    t = summary["touch"]
+    print(f"{name} touch-to-present p50={fmt(t['presentP50'])} p95={fmt(t['presentP95'])} "
+          f"touch-to-script p50={fmt(t['clickP50'])} p95={fmt(t['clickP95'])}")
+    f = summary["freeze"]
+    print(f"{name} freeze sleeps={f['sleeps']} presents-in-sleeps={f['presentsInSleeps']} "
+          f"max-gap={fmt(f['maxGapMs'])} input-p50={fmt(f['inputP50'])} input-p95={fmt(f['inputP95'])} "
+          f"input-max={fmt(f['inputMax'])}")
+    r = summary["resources"]
+    print(f"{name} resources threads={r['threadsBefore']}/{r['threadsOpen']}/{r['threadsClosed']} "
+          f"pss-delta-kb={r['pssDeltaKb']} graphics-delta-kb={r['graphicsDeltaKb']} "
+          f"native-delta-kb={r['nativeDeltaKb']} pss-after-close-kb={r['pssAfterCloseKb']}")
+    expected_render = 0 if mode == "off" else 1
+    checks = [
+        ("mode-active", r["renderThreadsOpen"] == expected_render, f"render-threads={r['renderThreadsOpen']}"),
+        ("render-thread-exit", r["renderThreadsClosed"] == 0, f"render-threads={r['renderThreadsClosed']}"),
+        ("clicks", t["clicks"] == 5, f"clicks={t['clicks']}/5"),
+        ("slider-edit", t["sliderValue"] != 20 and t["edits"] > 0,
+         f"value={fmt(float(t['sliderValue']))} edits={t['edits']}"),
+    ]
+    if mode == "replay":
+        checks.append(("replay-rejects", summary["replayRejects"] is True, f"threw={summary['replayRejects']}"))
+    ok = True
+    for check, passed, detail in checks:
+        print(f"{name} {check} {'PASS' if passed else 'FAIL'} {detail}")
+        ok = ok and passed
+    return ok
+
+
+TABLE_ROWS = [
+    ("light: present fps", "light", "presentFps"),
+    ("light: frame interval p50 / p95 (ms)", "light", ("frameP50", "frameP95")),
+    ("light: script build p50 / p95 (ms)", "light", ("buildP50", "buildP95")),
+    ("light: script submit p50 / p95 (ms)", "light", ("submitP50", "submitP95")),
+    ("heavy: present fps", "heavy", "presentFps"),
+    ("heavy: frame interval p50 / p95 (ms)", "heavy", ("frameP50", "frameP95")),
+    ("heavy: script build p50 / p95 (ms)", "heavy", ("buildP50", "buildP95")),
+    ("heavy: script submit p50 / p95 (ms)", "heavy", ("submitP50", "submitP95")),
+    ("touch-to-present p50 / p95 (ms)", "touch", ("presentP50", "presentP95")),
+    ("touch-to-script p50 / p95 (ms)", "touch", ("clickP50", "clickP95")),
+    ("sleep(500): presents inside the sleeps", "freeze", "presentsInSleeps"),
+    ("sleep(500): max present gap (ms)", "freeze", "maxGapMs"),
+    ("sleep(500): touch-to-present p50 / max (ms)", "freeze", ("inputP50", "inputMax")),
+    ("threads before / open / closed", "resources", ("threadsBefore", "threadsOpen", "threadsClosed")),
+    ("PSS delta open (KB)", "resources", "pssDeltaKb"),
+    ("graphics delta open (KB)", "resources", "graphicsDeltaKb"),
+    ("native heap delta open (KB)", "resources", "nativeDeltaKb"),
+]
+
+
+def table(directory: pathlib.Path) -> None:
+    runs = sorted(directory.glob("summary-*.json"))
+    summaries = [(path.stem[len("summary-"):], json.loads(path.read_text(encoding="utf-8"))) for path in runs]
+    print("| metric | " + " | ".join(name for name, _ in summaries) + " |")
+    print("|---|" + "---|" * len(summaries))
+    for title, group, keys in TABLE_ROWS:
+        cells = []
+        for _, summary in summaries:
+            data = summary[group]
+            if isinstance(keys, tuple):
+                cells.append(" / ".join(fmt(data[key]) for key in keys))
+            else:
+                cells.append(fmt(data[keys]))
+        print(f"| {title} | " + " | ".join(cells) + " |")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("-s", "--serial")
+    parser.add_argument("--label", default="run")
+    parser.add_argument("--modes", default="off")
+    parser.add_argument("--out", type=pathlib.Path)
+    parser.add_argument("--timeout", type=float, default=150)
+    parser.add_argument("--table", type=pathlib.Path, help="print the comparison of the summaries in a directory")
+    args = parser.parse_args()
+    if args.table:
+        table(args.table)
+        return 0
+    if not args.serial or not args.out:
+        parser.error("--serial and --out are required for a run")
+    args.out.mkdir(parents=True, exist_ok=True)
+    ok = True
+    for mode in args.modes.split(","):
+        raw = run_mode(args.serial, mode, args.out, args.label, args.timeout)
+        if raw is None:
+            ok = False
+            continue
+        summary = summarize(raw)
+        (args.out / f"summary-{args.label}-{mode}.json").write_text(json.dumps(summary, indent=1), encoding="utf-8")
+        ok = report(args.label, summary) and ok
+        time.sleep(2)
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
