+// R8 render thread evaluation probe: frame statistics of whichever thread presents the frames.
+// Series (milliseconds): build = nativeNewFrame entry -> nativeRender entry (the render callback),
+// submit = nativeRender entry -> return, render = render start -> eglSwapBuffers return on the presenting
+// thread, present = eglSwapBuffers return relative to the last reset, inputLatency = present of the frame
+// that consumed a touch -> the touch's MotionEvent time.
+constexpr size_t kMaxStatSamples = 20000U;
+
+int64_t MonotonicNanos() {
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<int64_t>(now.tv_sec) * 1000000000LL + static_cast<int64_t>(now.tv_nsec);
+}
+
+struct FrameStatistics {
+    std::mutex mutex;
+    int64_t originNs = MonotonicNanos();
+    std::vector<double> buildMs;
+    std::vector<double> submitMs;
+    std::vector<double> renderMs;
+    std::vector<double> presentMs;
+    std::vector<double> inputLatencyMs;
+};
+
+FrameStatistics gStats;
+std::atomic<int64_t> gLastReleaseEventNs{0};
+// Touch times consumed into Dear ImGui IO for the frame being built (script thread, under NATIVE_LOCK).
+std::vector<int64_t> gFrameInputNs;
+int64_t gFrameStartNs = 0;
+
+void AddSample(std::vector<double>& series, double value) {
+    if (series.size() < kMaxStatSamples) {
+        series.push_back(value);
+    }
+}
+
+void RecordBuild(double buildMs, double submitMs) {
+    std::lock_guard<std::mutex> lock(gStats.mutex);
+    AddSample(gStats.buildMs, buildMs);
+    AddSample(gStats.submitMs, submitMs);
+}
+
+void RecordPresent(int64_t renderStartNs, int64_t presentNs, const std::vector<int64_t>& inputNs) {
+    std::lock_guard<std::mutex> lock(gStats.mutex);
+    AddSample(gStats.renderMs, static_cast<double>(presentNs - renderStartNs) / 1.0e6);
+    AddSample(gStats.presentMs, static_cast<double>(presentNs - gStats.originNs) / 1.0e6);
+    for (const int64_t eventNs : inputNs) {
+        if (eventNs > 0 && eventNs <= presentNs) {
+            AddSample(gStats.inputLatencyMs, static_cast<double>(presentNs - eventNs) / 1.0e6);
+        }
+    }
+}
+
